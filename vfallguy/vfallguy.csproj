<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<!--
			Fork versioning: upstream's 4th segment x1000 plus a local revision
			(upstream 0.0.0.12 -> 0.0.0.12001), so fork builds sort above the
			matching upstream release and below the next one.
		-->
		<Version>0.0.0.12006</Version>
		<LangVersion>preview</LangVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))'">
		<DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
	</PropertyGroup>
</Project>